# Server
PORT=4000
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173
# At least 32 characters. Generate with: openssl rand -base64 32
SESSION_SECRET=change-me-long-random-string

# Database / Redis (match docker-compose.yml)
DATABASE_URL=postgresql://clipboard:clipboard@localhost:5432/clipboard
REDIS_URL=redis://localhost:6379

# Google OAuth (Google Cloud Console > APIs & Services > Credentials)
# OAuth client type "Web application"; add both redirect URIs below as authorized redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:4000/auth/google/drive/callback

# 32 random bytes, base64. Generate with: openssl rand -base64 32
TOKEN_ENC_KEY=

# 7 while the OAuth app is in Testing mode; leave empty once published to production
DRIVE_REFRESH_TOKEN_TTL_DAYS=7

# Limits
MAX_FILE_SIZE_MB=100
MAX_TEXT_KB=100
PIN_RATE_LIMIT=10
PIN_TTL_MIN_MINUTES=5
PIN_TTL_MAX_MINUTES=15
